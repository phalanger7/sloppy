# covgap's coverage database — regenerated on demand, never committed.
.covgap-coverage

# NOTE: .qa-baseline.txt is deliberately NOT ignored. It records which
# findings were consciously accepted and is meaningless unversioned.

# The channel's own state. Normally lives under $XDG_DATA_HOME/sloppy, but
# never commit one that lands here: between them these are a dossier on real
# people and a verbatim log of everything they said.
profiles.json
memory.json
chatlog.jsonl
chatlog.jsonl.tmp

# python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.venv/
venv/

# Working notes and agent instructions. Kept locally, deliberately not
# published: they are a running log of this channel and its people rather than
# anything a reader of the repo needs.
NOTES.md
AGENTS.md

# Which server, channel and nick this particular bot connects to, read on top
# of sloppy.toml. The tracked file carries neutral examples; the real values
# live here and are nobody else's business.
sloppy.local.toml

# Where the quality gate lives on this machine. Not a project setting.
.qa-gate-path

# How this machine starts llama.cpp: which model file, from which directory.
# That is the operator's setup, not part of the bot.
start_llm.sh
